{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:9876/v1"
      },
      "models": {
        "qwen3.6_4q": {
          "name": "Qwen3.6 35B-A3B 4Q",
          "tools": true,
          "limit": {
            "context": 40960,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny"
    },
    "edit": "ask",
    "bash": "ask"
  }
}
