{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:9876/v1"
      },
      "models": {
        "qwen3.6_4q": {
          "name": "Qwen3.6 35B-A3B 4Q",
          "tools": true,
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (IQ4_XS, MTP)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 40960,
            "input": 32768,
            "output": 8192
          },
          "options": {
            "top_p": 0.95
          },
          "variants": {
            "none": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "low": {
              "chat_template_kwargs": {
                "reasoning_effort": "low",
                "preserve_thinking": true
              },
              "reasoning_budget_tokens": 1024
            },
            "medium": {
              "chat_template_kwargs": {
                "reasoning_effort": "medium",
                "preserve_thinking": true
              },
              "reasoning_budget_tokens": 3072
            },
            "xhigh": {
              "chat_template_kwargs": {
                "reasoning_effort": "xhigh",
                "preserve_thinking": true
              },
              "reasoning_budget_tokens": 6144
            }
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny"
    },
    "edit": "ask",
    "bash": "ask"
  }
}
