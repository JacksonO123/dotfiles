{
  "group/distro-group": {
    "orientation": "horizontal",
    "modules": [
      "image#distro",
      "custom/search",
      "custom/terminal",
      "custom/files",
      "custom/music",
      "custom/browser"
    ]
  },
  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false
    },
    "modules": ["pulseaudio", "pulseaudio/slider", "pulseaudio#microphone"]
  },
  "group/connections": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "network"]
  },
  "group/tray-group": {
    "orientation": "horizontal",
    "modules": ["tray", "custom/tray-arrow"]
  }
}
