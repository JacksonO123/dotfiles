{
  "group/distro-group": {
    "orientation": "horizontal",
    "modules": [
      "image#distro",
      "image#search",
      "image#terminal",
      // "custom/code",
      // "custom/obsidian",
      "image#files",
      "image#music",
      "image#browser"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": ["disk", "memory", "temperature", "cpu"]
  },
  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false
    },
    "modules": ["pulseaudio", "pulseaudio/slider", "pulseaudio#microphone"]
  },
  "group/connections": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "network"]
  },
  "group/tray-group": {
    "orientation": "horizontal",
    "modules": ["tray", "custom/tray-arrow"]
  }
}
