{
  "image#distro": {
    "path": "/home/jotto/.config/waybar/assets/arch-orb.png",
    "size": 35,
    "on-click-release": "~/.local/bin/control-center",
    "on-click": "true",
    "tooltip": false
  },
  "custom/search": {
    "format": " ",
    "on-click-release": "~/.local/bin/spotlight --config ~/.config/jotto-utils/spotlight/desktop.conf",
    "on-click": "true",
    "tooltip": false
  },
  "custom/terminal": {
    "format": " ",
    "on-click-release": "alacritty",
    "on-click": "true",
    "tooltip": false
  },
  "custom/files": {
    "format": " ",
    "on-click-release": "dolphin",
    "on-click": "true",
    "tooltip": false
  },
  "custom/music": {
    "format": " ",
    "on-click-release": "spotify-launcher",
    "on-click": "true",
    "tooltip": false
  },
  "custom/browser": {
    "format": " ",
    "on-click-release": "google-chrome-stable",
    "on-click": "true",
    "tooltip": false
  }
}
